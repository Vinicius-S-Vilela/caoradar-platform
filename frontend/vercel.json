{
  "version": 2,
  "public": false,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/cao-radar",
  "github": {
    "silent": true
  },
  "routes": [
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|json|webp))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
